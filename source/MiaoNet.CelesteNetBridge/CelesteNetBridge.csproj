<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="CelesteMod.props" />

  <PropertyGroup>
    <CelesteRootPath>C:\Program Files (x86)\Steam\steamapps\common\Celeste</CelesteRootPath>
    <AssemblyName>MiaoNetCelesteNetBridge</AssemblyName>
    <RootNamespace>MiaoNet.CelesteNetBridge</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Not a standalone mod: do not copy a Mods/<name>_copy folder into the game. -->
    <ModAssetsCopyType>none</ModAssetsCopyType>
    <UseCelesteAnalyzer>false</UseCelesteAnalyzer>
    <UseCelestePublicizer>true</UseCelestePublicizer>
    <!-- The protocol layer under Protocol/ deliberately has no Celeste/Everest dependency: the unit
         test project links those files directly, so it can assert on real bytes without a game. -->
    <DefineConstants>$(DefineConstants);MIAO_BRIDGE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- The bridge is a NetMod consumer: it registers a NetMod and ships CelesteNet frames through
         the pipeline. MiaoNet.dll is provided at runtime by the MiaoNet mod itself. -->
    <ProjectReference Include="..\MiaoNet.Client\MiaoNet.Client.csproj">
      <Private>false</Private>
    </ProjectReference>

    <!-- Suppression hooks detour the real CelesteNet client (installed as a normal mod). -->
    <CelesteModReference Include="CelesteNet.Client" />
    <!-- A follow-up PR adds the second reference below: the relay filter needs the CelesteNet.Shared
         assembly to tell CelesteNet's own DataTypes from a mod's.
         <CelesteModReference Include="CelesteNet.Client" AssemblyName="CelesteNet.Shared" /> -->

    <None Include="CelesteMod*" Visible="false" />
  </ItemGroup>

  <!-- A follow-up PR adds the CopyBridgeIntoMiaoNetMod AfterBuild target here: it drops this assembly
       into source/MiaoNet.Client/ModFolder/Code as Code/MiaoNetCelesteNetBridge.dll, which is where
       MiaoNet loads it from by reflection. This PR only ships the dependency-free protocol layer. -->
  <Import Project="CelesteMod.targets" />
</Project>
